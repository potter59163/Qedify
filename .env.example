# Copy to .env.local (git-ignored) for local development.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Claude API key for the AI coach. Server-side only: never prefix it with
# EXPO_PUBLIC_, or it would be bundled into the app.
ANTHROPIC_API_KEY=

# Optional: override the model the coach uses (default: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Native builds only: the origin that hosts /api/coach.
# EXPO_PUBLIC_API_BASE=https://your-deployment.vercel.app

# Public origin of the deployed site, used for canonical links and social cards.
# EXPO_PUBLIC_SITE_URL=https://qedify.vercel.app
